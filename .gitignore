# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
*.log
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Server-only local Arena database, sessions, salted credential hashes and backups.
/.arena/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Local reference downloads, recordings and private operator output.
/dm-qinglian-extract/
/docs/qa-evidence/
/docs/references/
*.har
*.zip
/supabase/.temp/
# Keep the owner's uncommitted merged font local; deploy uses the already tracked font.
/public/fonts/scene-sarabun.ttf

.vercel
.env*
!.env.example

# Owner art intake (originals stay local; runtime copies live in public/arena/economy/catalog)
/artwork_inbox/

# Blender auto-backups (local only)
*.blend1
